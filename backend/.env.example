# Copy this file to ".env" (same folder) and edit the values. Never commit ".env".
DB_URL=jdbc:postgresql://localhost:5432/shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=change_me_db_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
TOKEN_SECRET=change_me_to_a_long_random_string_of_32_chars_or_more
TOKEN_EXPIRY_HOURS=8

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development admin account created on first start (change for any shared environment)
ADMIN_EMAIL=admin@shopsphere.local
ADMIN_PASSWORD=Admin@123

# Insert sample categories, products and a demo customer when the database is empty
SEED_DEMO_DATA=true
